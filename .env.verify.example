# Copy to .env.verify. Do not store real credentials in this example.
VERIFY_DATABASE_URL=postgres://proofs:proof-local-only@127.0.0.1:55432/peergit_proofs?sslmode=disable
VERIFY_LOCAL_ENDPOINT=http://127.0.0.1:58333
VERIFY_LOCAL_BUCKET=proofs
VERIFY_LOCAL_ACCESS_KEY=proof-local
VERIFY_LOCAL_SECRET_KEY=proof-local-only
VERIFY_GITHUB_APP_ID=
VERIFY_GITHUB_INSTALLATION_ID=
VERIFY_GITHUB_PRIVATE_KEY_PATH=
VERIFY_GITHUB_SELECTED_REPO=
VERIFY_GITHUB_EXCLUDED_REPO=
VERIFY_GITHUB_REF=main
# After reading docs/verification/contract.md and walkthrough.html, record your review.
VERIFY_CONTRACT_ACCEPTED=false
