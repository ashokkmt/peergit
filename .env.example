APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=debug
DATABASE_URL=postgres://peergit:local-development-only@127.0.0.1:5432/peergit?sslmode=disable
DATABASE_MAX_CONNS=20
CURSOR_SIGNING_KEY=local-development-only-cursor-key-change-before-deploy
APP_ORIGIN=https://localhost
COOKIE_SECURE=true
SESSION_HASH_KEY=local-development-only-session-hash-key
MFA_ENCRYPTION_KEY=local-development-only-mfa-encryption-key
# Configure these together when testing Google sign-in. Register the callback URL exactly.
GOOGLE_OIDC_ISSUER=https://accounts.google.com
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URL=
# Optional local S3-compatible object store for profile media.
OBJECT_ENDPOINT=http://127.0.0.1:8333
OBJECT_REGION=us-east-1
OBJECT_BUCKET=peergit-local
OBJECT_ACCESS_KEY=local-object-access
OBJECT_SECRET_KEY=local-object-secret
SMTP_HOST=127.0.0.1:1025
